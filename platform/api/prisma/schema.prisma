// Prisma schema for the Root Cause CTF platform API.
// Deployment uses `prisma db push` (no migration files are kept in the repo).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  web
  pwn
  crypto
  misc
}

enum Difficulty {
  easy
  medium
  hard
}

model User {
  id        String   @id @default(cuid())
  githubId  String   @unique
  username  String
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())

  solves      Solve[]
  submissions Submission[]
  runs        Run[]
  apiKeys     ApiKey[]
}

model Challenge {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  cveId       String
  category    Category
  difficulty  Difficulty
  points      Int
  summary     String
  description String
  // Published image name students pull in the self-host compose. Defaults to ""
  // so `prisma db push` can add the column to existing rows without data loss;
  // the seed sets the real values.
  image       String     @default("")
  // sha256 hex of the static flag; null for challenges validated per-run.
  // Ignored when `dynamic` is true.
  flagHash    String?
  order       Int
  active      Boolean    @default(true)
  // true = flag is validated against the user's Run flags (self-host, per-run
  // flag minted by POST /challenges/:slug/run). false = static flagHash.
  dynamic     Boolean    @default(false)
  createdAt   DateTime   @default(now())

  solves      Solve[]
  submissions Submission[]
  runs        Run[]
}

model Solve {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  // Points awarded for this solve: base + speed bonus (see lib/scoring.ts).
  points      Int      @default(0)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  correct     Boolean
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@index([userId, challengeId])
}

// A per-run flag minted for a user running a dynamic challenge locally via the
// self-host compose. `POST /challenges/:slug/run` creates one and returns the
// raw flag (never stored; only `flagHash` lives here) for the flagger sidecar
// to write into the challenge container. A submitted flag validates against the
// hashes of this user's runs for the challenge (see lib/runs.ts).
model Run {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  flagHash    String
  createdAt   DateTime  @default(now())
  solvedAt    DateTime?

  user      User      @relation(fields: [userId], references: [id])
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@index([userId, challengeId])
}

// An API key authenticates `POST /challenges/:slug/run` (the flagger sidecar).
// Only the sha256 hash of the raw key is stored, plus a short display prefix.
// One active (non-revoked) key per user: regenerating revokes the prior one.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  hashedKey  String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revoked    Boolean   @default(false)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
