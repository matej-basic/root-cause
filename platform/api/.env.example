# Postgres connection string. Railway provides this when you attach a Postgres
# plugin; locally point it at your own database.
DATABASE_URL=postgresql://user:password@localhost:5432/forwarding_labs

# Secret for signing app JWTs and the OAuth CSRF state. Use a long random value.
JWT_SECRET=replace-with-a-long-random-string

# GitHub OAuth app credentials.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Must equal {API_ORIGIN}/auth/github/callback and match the GitHub OAuth app.
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# Frontend origin. Used for the post-login redirect and the CORS allowlist.
WEB_ORIGIN=http://localhost:3000

# Port the API listens on. Railway sets this automatically in production.
PORT=4000
